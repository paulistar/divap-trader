# Application
APP_ENV=development
APP_DEBUG=true
API_KEY=change-me-in-production

# Senha curta só para o painel web (/dashboard) — recomendado
DASHBOARD_TOKEN=defina-um-pin-seguro
LOG_LEVEL=INFO

# Produção: https://trade.martstudiosbr.com.br (VPS :80 + Cloudflare)

# Database (TimescaleDB)
DATABASE_URL=postgresql://divap:divap@postgres:5432/divap

# Redis
REDIS_URL=redis://redis:6379/0

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# Execução automatizada (Fase 3 — testnet por padrão)
TRADING_ENABLED=false
TRADING_MODE=testnet
TRADING_MIN_CONFIDENCE=high
TRADING_BLOCK_ON_CONTEXT_REJECT=true
TRADING_MAX_OPEN_TRADES=5
TRADING_DRY_RUN=false

# Forex — FXCM demo (Token Management no Trading Station, não usa login/senha na API)
# FXCM_ACCESS_TOKEN=
# FXCM_SERVER=demo
# FXCM_ACCOUNT_ID=

# OTC — IQ Option (conta demo/prática; API não oficial — use só PRACTICE)
IQOPTION_EMAIL=
IQOPTION_PASSWORD=
IQOPTION_ACCOUNT_MODE=PRACTICE
OTC_TRADING_ENABLED=false

# Contexto de mercado (Apolo + validação pré-entrada)
CONTEXT_ENABLED=true
CONTEXT_NEWS_LIMIT=5
CRYPTOPANIC_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_TRIAGE=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telethon (OTC user / Tasso / Invezt) — https://my.telegram.org/apps
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_USER_SESSION=

# Tasso — Financial Move Bot 3.0 (execução Binance)
# TASSO_TELEGRAM_ENABLED=false
# TASSO_FINANCIAL_MOVE_BOT=FinancialMoveBot

# Invezt — Maia PREMIUM (briefing perfis Binance; sem execução)
# INVEZT_TELEGRAM_ENABLED=false
# INVEZT_TELEGRAM_CHAT_REF=-1002515846658

# Web Push PWA (opcional — python scripts/generate_vapid.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:trade@martstudiosbr.com.br
