# Snippet para colar no Easypanel → divap-trader → Environment
#
# 1. Cole no FINAL do textarea Environment
# 2. Ligue "Create .env file"
# 3. Save → Deploy (nesta ordem)
#
# Recomendado: MCP oficial (sem SMS/2FA). Token em IQ Option → Settings → AI integrations.
# Marque "Trade · Digital Options" se quiser ordens reais (além de leitura).
#
# Painel: https://painel.martstudiosbr.com.br/projects/martstudios/compose/divap-trader/environment

###############
### OTC / IQ Option (perfil otc - conta demo) ###
###############
IQOPTION_MCP_TOKEN=
IQOPTION_MCP_URL=https://digital-options.mcp.iqoption.com
IQOPTION_ACCOUNT_MODE=PRACTICE
OTC_TRADING_ENABLED=false

# --- Telegram automático (modo user = grupo privado de sinais) ---
# Credenciais: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=
# Grupo/canal fonte: @username ou -1001234567890
OTC_TELEGRAM_CHAT_ID=

# Modo bot (só se o bot estiver no grupo): TELEGRAM_BOT_TOKEN já existe no env geral

# Legado (opcional — só se não usar MCP; pode exigir SMS 2FA)
# IQOPTION_EMAIL=
# IQOPTION_PASSWORD=""
