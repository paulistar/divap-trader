# Snippet para colar no Easypanel → divap-trader → Environment
#
# O Easypanel Compose NÃO lê variáveis do docker-compose automaticamente.
# Cole este bloco no FINAL do textarea "Environment" e clique Save + Deploy.
#
# Painel: https://painel.martstudiosbr.com.br/projects/martstudios/compose/divap-trader/environment

###############
### OTC / IQ Option (perfil otc — conta demo) ###
###############
IQOPTION_EMAIL=
IQOPTION_PASSWORD=
IQOPTION_ACCOUNT_MODE=PRACTICE
OTC_TRADING_ENABLED=false
